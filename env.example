# ---- Jira ----
JIRA_URL=https://your-jira.example.com
JIRA_TOKEN=

# Custom field IDs (find them in your Jira field settings)
JIRA_FIELD_TESTCASES=customfield_10001
JIRA_FIELD_BRANCH=customfield_10002
JIRA_FIELD_SOP=customfield_10003
JIRA_FIELD_SW_VERSION=customfield_10004
JIRA_FIELD_TEST_BENCHES=customfield_10005
JIRA_FIELD_DOMAINS=customfield_10006
JIRA_FIELD_HW_VERSION=customfield_10007
JIRA_FIELD_GROUP_NUMBER=customfield_10008

# Workflow transition IDs
JIRA_TRANSITION_IN_PROGRESS=11
JIRA_TRANSITION_DONE=21
JIRA_TRANSITION_WAITING_FEEDBACK=31

# ---- Jenkins ----
JENKINS_URL=https://your-jenkins.example.com
JENKINS_USERNAME=
JENKINS_API_TOKEN=
JENKINS_FLASHING_TOKEN=
JENKINS_EXECUTION_TOKEN=
FLASHING_JOB_NAME=flashing-job
EXECUTION_JOB_NAME=execution-job

# ---- Node scheduler / DUT requests ----
BTS_SCHEDULER_URL=https://your-scheduler.example.com/api/getNodes
DUT_REQUEST_URL=https://your-scheduler.example.com/api/add-request
DUT_CUSTOMER=CUSTOMER
DUT_PROJECT=PROJECT
DUT_KEY_TYPE=KEY
DUT_LOCATION=LOCATION

# ---- Job / test settings ----
NODE_ACTIVITY=Execution
DEFAULT_DOMAIN=DEFAULT
DEFAULT_SOP=00-00__DEFAULT
KEYWORD_VERSION=1.0.0
HW_TYPE=HW
SW_ARTIFACT_PATH_TEMPLATE=releases/{sw}/package.zip
SW_PROFILES_FILE=sw_profiles.json

# ---- Email notifications (optional) ----
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=
NOTIFICATION_EMAIL=
